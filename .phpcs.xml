<?xml version="1.0"?>
<ruleset name="WikiOasis mw-config">
	<rule ref="./vendor/mediawiki/mediawiki-codesniffer/MediaWiki">
		<exclude name="Generic.Files.LineLength" />
		<exclude name="MediaWiki.NamingConventions.ValidGlobalName" />
		<exclude name="MediaWiki.NamingConventions.PrefixedGlobalFunctions" />
		<exclude name="MediaWiki.Usage.SuperGlobalsUsage" />
		<exclude name="Generic.PHP.NoSilencedErrors" />
	</rule>
	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<arg name="extensions" value="php" />
	<arg name="encoding" value="UTF-8" />
</ruleset>
